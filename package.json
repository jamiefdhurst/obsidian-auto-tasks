{
  "name": "obsidian-auto-tasks",
  "version": "0.10.0",
  "description": "Combine periodic notes with tags and tasks to automatically manage your daily, weekly and project TODO lists. Optionally uses the Periodic Notes and Tasks plugins.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "sh fix-jest-environment-obsidian.sh && jest",
    "coverage": "sh fix-jest-environment-obsidian.sh && jest --coverage",
    "test-ci": "sh fix-jest-environment-obsidian.sh && jest --ci --reporters=default --reporters=jest-junit --coverage",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepare": "husky",
    "version": "node version-bump.mjs"
  },
  "keywords": [],
  "author": "Jamie Hurst <jamie@jamiehurst.co.uk>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jamiefdhurst/obsidian-auto-tasks/issues"
  },
  "homepage": "https://github.com/jamiefdhurst/obsidian-auto-tasks#readme",
  "dependencies": {
    "obsidian-periodic-notes-provider": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-environment-obsidian": "^0.0.1",
    "jest-junit": "^17.0.0",
    "moment": "^2.30.1",
    "nano-staged": "^0.9.0",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "nano-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}
